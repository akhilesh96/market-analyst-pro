# ==========================================================
# Market Analyst Pro — Environment Configuration
# ==========================================================
# Mode selection:
#   mock -> Uses deterministic fake 15m candles & simulated AI latency (Milestone 1)
#   real -> Uses Python yfinance bridge & local Ollama LLM (Milestone 2)
APP_PROVIDER_MODE=mock

# Database Configuration
POSTGRES_DB=market_analyst
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Backend Configuration
SERVER_PORT=8080
MARKET_DATA_BASE_URL=http://localhost:8000
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Concurrency & Resilience Tuning
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2
